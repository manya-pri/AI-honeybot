# Local demonstration settings. Keep the Flask service loopback-only.
APP_ENV=development
DEMO_MODE=false
DATABASE_URL=sqlite:///data/honeybot.sqlite
HONEYPOT_DATABASE=data/honeybot.sqlite
LLM_ENABLED=false
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
RISK_THRESHOLD_HIGH=60
RISK_THRESHOLD_CRITICAL=80
RISK_THRESHOLD_MEDIUM=30
MIN_SUSPICIOUS_EVENTS=3
CONTAINMENT_DURATION=300
GEOIP_API_KEY=

# Settings currently consumed by the existing Flask implementation
HONEYPOT_PORT=5000
HONEYPOT_HOST=127.0.0.1
HONEYPOT_EVENTS_FILE=data/events.jsonl
HONEYPOT_BLOCK_DURATION_SECONDS=300
HONEYPOT_BLOCK_AFTER_HIGH_RISK=3
HONEYPOT_AUTH_BLOCK_AFTER=3
# Optional local MaxMind database paths; there is no external GeoIP API call.
HONEYPOT_GEOIP_CITY_DB=
HONEYPOT_GEOIP_ASN_DB=
# Simulator events use visibly labelled fictional map coordinates.
DEMO_MODE=false
# Streamlit Run Demo sends its synthetic event sequence to this FastAPI service.
HONEYPOT_API_URL=http://127.0.0.1:8000
